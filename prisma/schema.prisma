generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  HR_MANAGER
  HR_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  role      UserRole   @default(HR_STAFF)
  status    UserStatus @default(ACTIVE)
  avatar    String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  accounts            Account[]
  ownedCandidates     Candidate[]           @relation("CandidateOwner")
  assignedCandidates  CandidateAssignment[] @relation("AssignedTo")
  candidateNotes      CandidateNote[]
  takeovers           HumanTakeover[]
  interviews          Interview[]           @relation("Interviewer")
  createdInterviews   Interview[]           @relation("CreatedBy")
  interviewFeedbacks  InterviewFeedback[]
  hiringDecisions     HiringDecision[]
  auditLogs           AuditLog[]
  sentMessages        Message[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// JOB POSITIONS
// ─────────────────────────────────────────────

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

enum WorkType {
  ONSITE
  WFH
  HYBRID
}

model JobPosition {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  department         String?
  workType           WorkType  @default(ONSITE) @map("work_type")
  salaryMin          Int?      @map("salary_min")
  salaryMax          Int?      @map("salary_max")
  requiredExperience String?   @map("required_experience")
  workingTime        String?   @map("working_time")
  location           String?
  headcount          Int       @default(1)
  status             JobStatus @default(OPEN)
  ownerId            String?   @map("owner_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  candidates     Candidate[]
  screeningForms ScreeningForm[]
  interviews     Interview[]

  @@map("job_positions")
}

// ─────────────────────────────────────────────
// CANDIDATES
// ─────────────────────────────────────────────

enum CandidateStatus {
  NEW_APPLICANT
  BOT_SCREENING
  WAITING_HR_REVIEW
  NEED_MORE_INFO
  QUALIFIED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  PASSED
  REJECTED
  TALENT_POOL
  CLOSED
}

enum SourceChannel {
  LINE
  FACEBOOK
  WEBSITE
  MANUAL
  OTHER
}

enum ExperienceStatus {
  EXPERIENCED
  FRESH_GRADUATE
  NO_EXPERIENCE
}

enum WorkPreference {
  ONSITE
  WFH
  HYBRID
}

model Candidate {
  id                   String            @id @default(cuid())
  nickname             String?
  fullName             String?           @map("full_name")
  phone                String?
  email                String?
  age                  Int?
  lineUserId           String?           @unique @map("line_user_id")
  lineDisplayName      String?           @map("line_display_name")
  lineProfilePicUrl    String?           @map("line_profile_pic_url")
  facebookUserId       String?           @unique @map("facebook_user_id")
  sourceChannel        SourceChannel     @default(MANUAL) @map("source_channel")
  interestedPositionId String?           @map("interested_position_id")
  experienceStatus     ExperienceStatus? @map("experience_status")
  experienceDetail     String?           @map("experience_detail")
  expectedSalary       Int?              @map("expected_salary")
  availableStartDate   DateTime?         @map("available_start_date")
  workPreference       WorkPreference?   @map("work_preference")
  hasComputer          Boolean?          @map("has_computer")
  hasInternet          Boolean?          @map("has_internet")
  resumeUrl            String?           @map("resume_url")
  portfolioUrl         String?           @map("portfolio_url")
  notionPageId         String?           @map("notion_page_id")
  currentStatus        CandidateStatus   @default(NEW_APPLICANT) @map("current_status")
  ownerId              String?           @map("owner_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  interestedPosition JobPosition?             @relation(fields: [interestedPositionId], references: [id])
  owner              User?                    @relation("CandidateOwner", fields: [ownerId], references: [id])
  tags               CandidateTag[]
  notes              CandidateNote[]
  statusHistory      CandidateStatusHistory[]
  assignments        CandidateAssignment[]
  conversations      Conversation[]
  screeningAnswers   ScreeningAnswer[]
  candidateScore     CandidateScore?
  aiSummary          AiSummary?
  interviews         Interview[]
  hiringDecision     HiringDecision?

  @@map("candidates")
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  color     String       @default("#6366f1")
  createdAt DateTime     @default(now()) @map("created_at")

  candidates CandidateTag[]

  @@map("tags")
}

model CandidateTag {
  candidateId String   @map("candidate_id")
  tagId       String   @map("tag_id")
  createdAt   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([candidateId, tagId])
  @@map("candidate_tags")
}

model CandidateNote {
  id          String   @id @default(cuid())
  candidateId String   @map("candidate_id")
  content     String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@map("candidate_notes")
}

model CandidateStatusHistory {
  id          String           @id @default(cuid())
  candidateId String           @map("candidate_id")
  fromStatus  CandidateStatus? @map("from_status")
  toStatus    CandidateStatus  @map("to_status")
  changedById String?          @map("changed_by_id")
  reason      String?
  createdAt   DateTime         @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_status_history")
}

model CandidateAssignment {
  id           String   @id @default(cuid())
  candidateId  String   @map("candidate_id")
  assignedToId String   @map("assigned_to_id")
  assignedById String?  @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignedTo User      @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@map("candidate_assignments")
}

// ─────────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────────

enum ConversationStatus {
  ACTIVE
  CLOSED
  WAITING
}

enum MessageSender {
  CANDIDATE
  BOT
  HR
  SYSTEM
}

model Conversation {
  id            String             @id @default(cuid())
  candidateId   String             @map("candidate_id")
  channel       SourceChannel
  botEnabled    Boolean            @default(true) @map("bot_enabled")
  status        ConversationStatus @default(ACTIVE)
  unreadCount   Int                @default(0) @map("unread_count")
  lastMessageAt DateTime?          @map("last_message_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  messages       Message[]
  takeovers      HumanTakeover[]
  aiConversation AIConversation?

  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  content        String
  messageType    String        @default("text") @map("message_type") // text | image | file | sticker | video | audio
  mediaUrl       String?       @map("media_url")
  senderType     MessageSender @map("sender_type")
  senderId       String?       @map("sender_id")
  externalId     String?       @map("external_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model HumanTakeover {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  hrId           String   @map("hr_id")
  action         String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  hr           User         @relation(fields: [hrId], references: [id])

  @@map("human_takeovers")
}

model QuickReply {
  id        String   @id @default(cuid())
  title     String
  content   String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("quick_replies")
}

// ─────────────────────────────────────────────
// SCREENING
// ─────────────────────────────────────────────

model ScreeningForm {
  id            String   @id @default(cuid())
  jobPositionId String   @map("job_position_id")
  title         String
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  jobPosition JobPosition         @relation(fields: [jobPositionId], references: [id])
  questions   ScreeningQuestion[]

  @@map("screening_forms")
}

model ScreeningQuestion {
  id              String   @id @default(cuid())
  screeningFormId String   @map("screening_form_id")
  question        String
  fieldKey        String   @map("field_key")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  screeningForm ScreeningForm   @relation(fields: [screeningFormId], references: [id], onDelete: Cascade)
  answers       ScreeningAnswer[]

  @@map("screening_questions")
}

model ScreeningAnswer {
  id                  String   @id @default(cuid())
  candidateId         String   @map("candidate_id")
  screeningQuestionId String   @map("screening_question_id")
  answer              String
  createdAt           DateTime @default(now()) @map("created_at")

  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  screeningQuestion ScreeningQuestion @relation(fields: [screeningQuestionId], references: [id])

  @@map("screening_answers")
}

model CandidateScore {
  id            String   @id @default(cuid())
  candidateId   String   @unique @map("candidate_id")
  experience    Int      @default(0)
  communication Int      @default(0)
  availability  Int      @default(0)
  salaryFit     Int      @default(0) @map("salary_fit")
  roleFit       Int      @default(0) @map("role_fit")
  attitude      Int      @default(0)
  totalScore    Int      @default(0) @map("total_score")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_scores")
}

model AiSummary {
  id             String   @id @default(cuid())
  candidateId    String   @unique @map("candidate_id")
  summary        String
  strengths      String?
  concerns       String?
  recommendation String?
  nextAction     String?  @map("next_action")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("ai_summaries")
}

// ─────────────────────────────────────────────
// INTERVIEW
// ─────────────────────────────────────────────

enum InterviewType {
  PHONE
  ONLINE
  ONSITE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum InterviewResult {
  PASSED
  WAITING
  REJECTED
  NEED_SECOND_INTERVIEW
}

model Interview {
  id            String          @id @default(cuid())
  candidateId   String          @map("candidate_id")
  jobPositionId String?         @map("job_position_id")
  interviewDate DateTime        @map("interview_date")
  startTime     String          @map("start_time")
  endTime       String          @map("end_time")
  interviewType InterviewType   @default(ONSITE) @map("interview_type")
  interviewerId String?         @map("interviewer_id")
  location      String?
  meetingLink   String?         @map("meeting_link")
  status        InterviewStatus @default(SCHEDULED)
  note          String?
  createdById   String?         @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  candidate    Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosition  JobPosition?       @relation(fields: [jobPositionId], references: [id])
  interviewer  User?              @relation("Interviewer", fields: [interviewerId], references: [id])
  createdBy    User?              @relation("CreatedBy", fields: [createdById], references: [id])
  feedback     InterviewFeedback?

  @@map("interviews")
}

model InterviewFeedback {
  id                String           @id @default(cuid())
  interviewId       String           @unique @map("interview_id")
  communication     Int              @default(0)
  personality       Int              @default(0)
  experience        Int              @default(0)
  roleUnderstanding Int              @default(0) @map("role_understanding")
  availability      Int              @default(0)
  attitude          Int              @default(0)
  salaryExpectation Int?             @map("salary_expectation")
  strengths         String?
  concerns          String?
  hrComment         String?          @map("hr_comment")
  finalResult       InterviewResult? @map("final_result")
  submittedById     String?          @map("submitted_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  submittedBy User?     @relation(fields: [submittedById], references: [id])

  @@map("interview_feedback")
}

// ─────────────────────────────────────────────
// HIRING DECISION
// ─────────────────────────────────────────────

enum HiringResult {
  PASSED
  REJECTED
  TALENT_POOL
  HIRED
  CLOSED
}

model HiringDecision {
  id          String       @id @default(cuid())
  candidateId String       @unique @map("candidate_id")
  result      HiringResult
  reason      String?
  note        String?
  decidedById String?      @map("decided_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation(fields: [decidedById], references: [id])

  @@map("hiring_decisions")
}

// ─────────────────────────────────────────────
// SYSTEM
// ─────────────────────────────────────────────

enum AuditAction {
  USER_LOGIN
  VIEW_CANDIDATE
  EDIT_CANDIDATE
  SEND_MESSAGE
  TAKEOVER_CONVERSATION
  RESUME_BOT
  ASSIGN_HR
  CHANGE_CANDIDATE_STATUS
  CREATE_INTERVIEW
  SUBMIT_INTERVIEW_FEEDBACK
  MAKE_HIRING_DECISION
  EXPORT_CANDIDATE
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  CREATE_TAG
  UPDATE_TAG
  DELETE_TAG
  ADD_CANDIDATE_TAG
  REMOVE_CANDIDATE_TAG
  ASSIGN_CANDIDATE
  UNASSIGN_CANDIDATE
  DELETE_CANDIDATE_NOTE
  CREATE_SCREENING_FORM
  UPDATE_SCREENING_FORM
  DELETE_SCREENING_FORM
  SUBMIT_SCREENING_ANSWERS
  SCORE_CANDIDATE
  GENERATE_AI_SUMMARY
  // Phase 11
  UPDATE_AI_PROVIDER
  UPDATE_AI_PERSONA
  UPDATE_AI_PROMPT
  PUBLISH_AI_PROMPT
  RESTORE_AI_PROMPT
  UPDATE_AI_SCREENING_FLOW
  UPDATE_AI_POSITION_RULE
  UPDATE_AI_FAQ
  UPDATE_AI_TEMPLATE
  UPDATE_AI_GUARDRAIL
  UPDATE_AI_HANDOFF_RULE
  UPDATE_AI_TAGGING_RULE
  UPDATE_AI_SCORING
  UPDATE_AI_SUMMARY_TEMPLATE
  RUN_AI_PLAYGROUND
  UPDATE_AI_COST_LIMIT
  UPDATE_AI_FALLBACK
  UPDATE_AI_ROUTING
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  action     AuditAction
  targetId   String?     @map("target_id")
  targetType String?     @map("target_type")
  detail     Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─────────────────────────────────────────────
// PHASE 11: AI CONFIG
// ─────────────────────────────────────────────

model AiProvider {
  id          String   @id @default(cuid())
  name        String   @unique // "anthropic", "openai", "kimi"
  displayName String   @map("display_name")
  apiKey      String?  @map("api_key")
  baseUrl     String?  @map("base_url")
  isActive    Boolean  @default(false) @map("is_active")
  defaultModel String? @map("default_model")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  routingRules AiModelRoutingRule[]

  @@map("ai_providers")
}

model AiPersona {
  id        String   @id @default(cuid())
  botName   String   @default("Daniel") @map("bot_name")
  tone      String   @default("professional")
  language  String   @default("thai_english")
  greeting  String?
  signature String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_personas")
}

enum PromptVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AiPromptVersion {
  id          String              @id @default(cuid())
  version     Int
  title       String
  content     String
  status      PromptVersionStatus @default(DRAFT)
  publishedAt DateTime?           @map("published_at")
  archivedAt  DateTime?           @map("archived_at")
  createdById String?             @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("ai_prompt_versions")
}

model AiScreeningFlow {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  greeting  String?
  closing   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions AiScreeningQuestion[]

  @@map("ai_screening_flows")
}

model AiScreeningQuestion {
  id        String   @id @default(cuid())
  flowId    String   @map("flow_id")
  question  String
  fieldKey  String   @map("field_key")
  required  Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  flow AiScreeningFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@map("ai_screening_questions")
}

model AiPositionRule {
  id            String   @id @default(cuid())
  jobPositionId String?  @map("job_position_id")
  isGlobal      Boolean  @default(false) @map("is_global")
  rule          String
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("ai_position_rules")
}

model AiFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_faqs")
}

model AiResponseTemplate {
  id        String   @id @default(cuid())
  name      String
  trigger   String?
  content   String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_response_templates")
}

model AiGuardrail {
  id          String   @id @default(cuid())
  type        String   // "blocked_topic", "required_disclosure", "max_messages"
  description String
  value       String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ai_guardrails")
}

model AiHandoffRule {
  id           String   @id @default(cuid())
  name         String
  triggerType  String   @map("trigger_type") // "keyword", "sentiment", "message_count", "time"
  triggerValue String   @map("trigger_value")
  action       String   // "notify_hr", "pause_bot", "notify_and_pause"
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ai_handoff_rules")
}

model AiTaggingRule {
  id          String   @id @default(cuid())
  name        String
  condition   String   // JSON: { field, operator, value }
  tagId       String?  @map("tag_id")
  tagName     String?  @map("tag_name")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ai_tagging_rules")
}

model AiScoringConfig {
  id        String   @id @default(cuid())
  name      String   @default("Default Scoring")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categories AiScoringCategory[]

  @@map("ai_scoring_configs")
}

model AiScoringCategory {
  id          String   @id @default(cuid())
  configId    String   @map("config_id")
  name        String
  weight      Int      @default(0)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  config AiScoringConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@map("ai_scoring_categories")
}

model AiSummaryTemplate {
  id        String   @id @default(cuid())
  name      String
  template  String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_summary_templates")
}

model AiPlaygroundTestRun {
  id           String   @id @default(cuid())
  name         String?
  providerId   String?  @map("provider_id")
  model        String?
  systemPrompt String?  @map("system_prompt")
  totalTokens  Int?     @map("total_tokens")
  totalCost    Float?   @map("total_cost")
  latencyMs    Int?     @map("latency_ms")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  messages AiPlaygroundMessage[]

  @@map("ai_playground_test_runs")
}

model AiPlaygroundMessage {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  role      String   // "user", "assistant", "system"
  content   String
  tokens    Int?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  run AiPlaygroundTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("ai_playground_messages")
}

model AiLog {
  id           String   @id @default(cuid())
  providerId   String?  @map("provider_id")
  model        String?
  action       String   // "chat", "screening", "summary", "playground"
  candidateId  String?  @map("candidate_id")
  promptTokens Int?     @map("prompt_tokens")
  outputTokens Int?     @map("output_tokens")
  totalTokens  Int?     @map("total_tokens")
  costEstimate Float?   @map("cost_estimate")
  latencyMs    Int?     @map("latency_ms")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("ai_logs")
}

model AiCostLimit {
  id        String   @id @default(cuid())
  period    String   @default("monthly") // daily, weekly, monthly
  limitUsd  Float    @map("limit_usd")
  alertAt   Float?   @map("alert_at") // percentage 0-100
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_cost_limits")
}

model AiModelRoutingRule {
  id          String   @id @default(cuid())
  useCase     String   @map("use_case") // "chat", "screening", "summary", "fallback"
  providerId  String?  @map("provider_id")
  model       String?
  maxTokens   Int?     @map("max_tokens")
  temperature Float?   @default(0.7)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider AiProvider? @relation(fields: [providerId], references: [id])

  @@map("ai_model_routing_rules")
}

model AiFallbackSetting {
  id              String   @id @default(cuid())
  enabled         Boolean  @default(true)
  maxRetries      Int      @default(2) @map("max_retries")
  fallbackMessage String?  @map("fallback_message")
  notifyHr        Boolean  @default(true) @map("notify_hr")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ai_fallback_settings")
}

// ─────────────────────────────────────────────
// PHASE 12: OPENCLAW INTEGRATION
// ─────────────────────────────────────────────

model AIConversation {
  id             String   @id @default(cuid())
  conversationId String   @unique @map("conversation_id")
  openclawId     String?  @map("openclaw_id")
  status         String   @default("ACTIVE")
  botEnabled     Boolean  @default(true) @map("bot_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_conversations")
}
